<div class="entity-bluetooth-device">
    <div class="title-row">
        <div class="name">{{.Name | html}}</div>
        {{if not .RSSIData.IsEmpty}}
            {{with .RSSIData -}}
            <div class="rssi-data">
            {{/* Bootstrap icon for signal strength indication: https://icons.getbootstrap.com/icons/reception-0/ */}}
                <div><i class="bi bi-reception-4"></i> {{.RSSI | html}}</div>
                {{/*<div>{{.LastUpdateTime | html}}</div>*/}}
            </div>
            {{end}}
        {{end}}
    </div>
    <div class="info-row">
        <div class="address">{{.Address | html}}{{if .Temporary}} <span class="temporary" title="This device changes its address from time to time, so it is not one to configure by">(changes address)</span>{{end}}</div>
        <div class="timestamp">
            <div class="label">Updated</div>
            <div class="value">{{RelativeTime .LastUpdateTime}}</div>
        </div>
    </div>
</div>